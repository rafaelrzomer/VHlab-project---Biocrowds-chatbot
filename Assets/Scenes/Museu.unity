  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f553d785e4d62524e80d416460bca54b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pointName: The Wedding at Cana
  pointDescription: "{\n  \"artwork\": {\n    \"title\": \"The Wedding at Cana\",\n   
    \"original_title\": \"Le Nozze di Cana\",\n    \"artist\": {\n      \"name\":
    \"Paolo Veronese\",\n      \"birth_year\": 1528,\n      \"death_year\": 1588,\n     
    \"nationality\": \"Italian\"\n    },\n    \"creation\": {\n      \"year\": 1563,\n     
    \"art_movement\": \"Venetian Renaissance\"\n    },\n    \"physical_properties\":
    {\n      \"type\": \"Oil painting\",\n      \"medium\": \"Oil on canvas\",\n     
    \"height_cm\": 677,\n      \"width_cm\": 994\n    },\n    \"location\": {\n     
    \"museum\": \"Louvre Museum\",\n      \"city\": \"Paris\",\n      \"country\":
    \"France\"\n    },\n    \"biblical_context\": {\n      \"source\": \"Gospel of
    John\",\n      \"event\": \"Wedding feast at Cana\",\n      \"description\":
    \"Jesus performs his first miracle by transforming water into wine\"\n    },\n   
    \"visual_description\": {\n      \"scene\": \"Large banquet with many guests
    seated around a long table\",\n      \"central_figures\": [\n        \"Jesus
    Christ\",\n        \"Virgin Mary\"\n      ],\n      \"number_of_figures_estimate\":
    130,\n      \"architecture\": [\n        \"classical columns\",\n        \"arches\",\n       
    \"renaissance palace structures\"\n      ],\n      \"animals\": [\n        \"dogs\"\n     
    ],\n      \"objects\": [\n        \"wine jars\",\n        \"silver plates\",\n       
    \"musical instruments\",\n        \"food\"\n      ]\n    },\n    \"composition\":
    {\n      \"focus_point\": \"Jesus positioned at the center of the composition\",\n     
    \"style\": \"Symmetrical banquet arrangement\",\n      \"perspective\": \"Deep
    architectural perspective\"\n    },\n    \"colors\": {\n      \"dominant_colors\":
    [\n        \"red\",\n        \"blue\",\n        \"gold\",\n        \"white\"\n     
    ],\n      \"lighting\": \"Bright and celebratory\"\n    },\n    \"symbolism\":
    [\n      \"Transformation and divine power\",\n      \"Celebration and abundance\",\n     
    \"Connection between earthly life and spirituality\"\n    ],\n    \"historical_significance\":
    [\n      \"Considered one of the masterpieces of Venetian Renaissance painting\",\n     
    \"Commissioned for the Benedictine monastery of San Giorgio Maggiore in Venice\",\n     
    \"Taken to France during the Napoleonic wars\"\n    ],\n    \"notable_details\":
    [\n      \"Several figures are believed to represent contemporary Venetian nobles\",\n     
    \"Veronese included a self-portrait among the musicians\",\n      \"The painting
    is one of the largest artworks displayed in the Louvre\"\n    ],\n    \"common_questions\":
    [\n      \"What miracle is represented in the painting?\",\n      \"Who painted
    The Wedding at Cana?\",\n      \"Why is the painting historically important?\",\n     
    \"Where is the artwork displayed?\",\n      \"Who are the central figures in
    the composition?\"\n    ]\n  }\n}"
  remember: 1
