  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f553d785e4d62524e80d416460bca54b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pointName: The Raft of the Medusa
  pointDescription: "{\n  \"artwork\": {\n    \"title\": \"The Raft of the Medusa\",\n   
    \"original_title\": \"Le Radeau de la M\xE9duse\",\n    \"artist\": {\n     
    \"name\": \"Th\xE9odore G\xE9ricault\",\n      \"birth_year\": 1791,\n      \"death_year\":
    1824,\n      \"nationality\": \"French\"\n    },\n    \"creation\": {\n     
    \"year\": 1819,\n      \"art_movement\": \"Romanticism\"\n    },\n    \"physical_properties\":
    {\n      \"type\": \"Oil painting\",\n      \"medium\": \"Oil on canvas\",\n     
    \"height_cm\": 491,\n      \"width_cm\": 716\n    },\n    \"location\": {\n     
    \"museum\": \"Louvre Museum\",\n      \"city\": \"Paris\",\n      \"country\":
    \"France\"\n    },\n    \"historical_context\": {\n      \"event\": \"Shipwreck
    of the French naval frigate Medusa\",\n      \"year\": 1816,\n      \"description\":
    \"After the shipwreck, survivors were abandoned on a makeshift raft for several
    days, facing starvation, dehydration, violence, and cannibalism\"\n    },\n   
    \"visual_description\": {\n      \"scene\": \"Group of desperate survivors on
    a damaged raft in the middle of a violent sea\",\n      \"environment\": [\n       
    \"stormy ocean\",\n        \"dark clouds\",\n        \"large waves\"\n      ],\n     
    \"human_conditions\": [\n        \"injured\",\n        \"dead\",\n        \"starving\",\n       
    \"hopeless\",\n        \"signaling for rescue\"\n      ],\n      \"objects\":
    [\n        \"raft\",\n        \"cloth used as signal\",\n        \"broken wood\"\n     
    ]\n    },\n    \"composition\": {\n      \"structure\": \"Triangular composition\",\n     
    \"focus_point\": \"Figures waving toward a distant rescue ship\",\n      \"movement\":
    \"Diagonal upward movement from death to hope\"\n    },\n    \"colors\": {\n     
    \"dominant_colors\": [\n        \"brown\",\n        \"dark green\",\n       
    \"gray\",\n        \"pale skin tones\"\n      ],\n      \"lighting\": \"Strong
    contrasts between light and shadow\"\n    },\n    \"themes\": [\n      \"Survival\",\n     
    \"Human suffering\",\n      \"Hope and despair\",\n      \"Political criticism\",\n     
    \"Nature versus humanity\"\n    ],\n    \"symbolism\": [\n      \"The raft symbolizes
    abandonment and political failure\",\n      \"The distant ship represents fragile
    hope\",\n      \"Dead and living bodies together emphasize human vulnerability\"\n   
    ],\n    \"historical_significance\": [\n      \"Based on a real tragedy that
    shocked France\",\n      \"Criticized the incompetence of the French government
    and navy\",\n      \"Considered a major masterpiece of Romanticism\"\n    ],\n   
    \"artist_preparation\": {\n      \"research_methods\": [\n        \"Interviewed
    survivors\",\n        \"Studied corpses in morgues\",\n        \"Built a model
    of the raft\"\n      ]\n    },\n    \"emotional_tone\": [\n      \"Chaotic\",\n     
    \"Tragic\",\n      \"Intense\",\n      \"Dramatic\"\n    ],\n    \"common_questions\":
    [\n      \"What historical event inspired the painting?\",\n      \"Why is The
    Raft of the Medusa important?\",\n      \"What themes are represented in the
    artwork?\",\n      \"Where is the painting displayed?\",\n      \"What artistic
    movement does it belong to?\"\n    ]\n  }\n}"
  remember: 1
