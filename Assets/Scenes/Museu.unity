  m_Name: 
  m_EditorClassIdentifier: 
  pointName: Mona Lisa
  pointDescription: "{\r\n  \"artwork\": {\r\n    \"title\": \"Mona Lisa\",\r\n   
    \"artist\": {\r\n      \"name\": \"Leonardo da Vinci\",\r\n      \"birth_year\":
    1452,\r\n      \"death_year\": 1519,\r\n      \"nationality\": \"Italian\"\r\n   
    },\r\n    \"creation\": {\r\n      \"start_year\": 1503,\r\n      \"end_year\":
    1519,\r\n      \"art_movement\": \"Renaissance\"\r\n    },\r\n    \"physical_properties\":
    {\r\n      \"type\": \"Oil painting\",\r\n      \"medium\": \"Oil on poplar wood
    panel\",\r\n      \"height_cm\": 77,\r\n      \"width_cm\": 53\r\n    },\r\n   
    \"location\": {\r\n      \"museum\": \"Louvre Museum\",\r\n      \"city\": \"Paris\",\r\n     
    \"country\": \"France\"\r\n    },\r\n    \"subject\": {\r\n      \"person_depicted\":
    \"Lisa Gherardini\",\r\n      \"description\": \"Woman seated with folded hands
    and subtle smile\"\r\n    },\r\n    \"visual_elements\": {\r\n      \"background\":
    [\r\n        \"mountains\",\r\n        \"river\",\r\n        \"winding roads\"\r\n     
    ],\r\n      \"dominant_colors\": [\r\n        \"brown\",\r\n        \"dark green\",\r\n       
    \"gold\"\r\n      ],\r\n      \"composition\": \"Portrait, frontal seated pose\"\r\n   
    },\r\n    \"techniques\": [\r\n      \"sfumato\",\r\n      \"soft lighting transitions\",\r\n     
    \"atmospheric perspective\"\r\n    ],\r\n    \"symbolism\": [\r\n      \"mysterious
    smile\",\r\n      \"human and nature harmony\",\r\n      \"psychological realism\"\r\n   
    ],\r\n    \"historical_significance\": [\r\n      \"One of the most famous paintings
    in history\",\r\n      \"Stolen in 1911 and recovered later\",\r\n      \"Major
    symbol of Renaissance art\"\r\n    ],\r\n    \"protection\": {\r\n      \"display_case\":
    \"Bulletproof glass\",\r\n      \"security_level\": \"High\"\r\n    },\r\n   
    \"common_questions\": [\r\n      \"Who painted the Mona Lisa?\",\r\n      \"Why
    is the Mona Lisa famous?\",\r\n      \"Where is the Mona Lisa located?\",\r\n     
    \"Who is the woman portrayed?\"\r\n    ]\r\n  }\r\n}"
  remember: 1
